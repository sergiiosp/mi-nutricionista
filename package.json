{
  "name": "nutricionista-mercadona",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pulso: nutricionista y entrenador personal con menús y lista de la compra de Mercadona",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/generar-sw.mjs",
    "preview": "vite preview --port 8080",
    "precios": "node scripts/actualizar-precios.mjs",
    "catalogo": "node scripts/descargar-catalogo.mjs",
    "test": "node scripts/probar-motor.mjs && node scripts/prueba-descanso.mjs && node scripts/prueba-agenda.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@lucide/svelte": "1.57.0",
    "barcode-detector": "^3.2.2",
    "idb-keyval": "^6.3.0",
    "qrcode-generator": "2.0.4"
  }
}
